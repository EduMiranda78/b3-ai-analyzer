# Obrigatória para relatórios explicados pelo Gemini.
# Sem esta chave, o sistema continua funcionando com o motor local.
GOOGLE_API_KEY=

# Modelo opcional. Ajuste conforme os modelos disponíveis na sua conta.
GEMINI_MODEL=gemini-3.6-flash

# Opcionais: envio da sinalização ao Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: caminho do SQLite.
# ANALISADOR_DB_PATH=instance/analisador.db

# Motor V3.1 em observação paralela. 1=ativo, 0=desativado.
SHADOW_V31_ENABLED=1
